+// User-client selector redirects for OCLP's old AMDRadeonX5000.kext on newer macOS (see kern_hooks.cpp).
+// Kandor (JessiesFlying, with assistance from Claude (Anthropic)), GPL-3.0-only.
+bool Patches::redirectsEnabled() {
+    return NVRAMArgs::isAMD() && getKernelVersion() >= KernelVersion::Ventura && !checkKernelArgument("-krynoredirect");
+}
+
+void Patches::routeAccelSharedExternalMethod(KernelPatcher &patcher, size_t index, mach_vm_address_t address, size_t size) {
+    if (!redirectsEnabled()) {
+        return;
+    }
+    KernelPatcher::RouteRequest request("__ZN24IOAccelSharedUserClient214externalMethodEjP25IOExternalMethodArgumentsP24IOExternalMethodDispatchP8OSObjectPv",
+                                        FunctionHooks::accelSharedExternalMethod, FunctionHooks::orgAccelSharedExternalMethod);
+    patchApplicator.applyRoutingPatch(index, patcher, &request, address, size);
+}
+
+void Patches::detectOldX5000(KernelPatcher &patcher, size_t index, mach_vm_address_t address, size_t size) {
+    if (!redirectsEnabled()) {
+        return;
+    }
+    // only the old (Monterey-era) kext still has ForceLegacyMode; Tahoe's own kext does not
+    mach_vm_address_t old = patcher.solveSymbol(index, "__ZN39AMDRadeonX5000_AMDAccelSharedUserClient15ForceLegacyModeEv", address, size);
+    FunctionHooks::oldX5000SharedUserClient = old != 0 && FunctionHooks::orgAccelSharedExternalMethod != 0;
+    SYSLOG(moduleName, "AMDRadeonX5000: old user-client numbering %s, selector redirects %s",
+           old ? "yes" : "no", FunctionHooks::oldX5000SharedUserClient ? "active" : "off");
+    patcher.clearError();
+}
