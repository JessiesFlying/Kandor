+// The same detection for OCLP's old Navi kext (Monterey AMDRadeonX6000.kext installed on Tahoe).
+// ne1rom, with assistance from Claude (Anthropic), GPL-3.0-only.
+void Patches::detectOldX6000(KernelPatcher &patcher, size_t index, mach_vm_address_t address, size_t size) {
+    if (!redirectsEnabled()) {
+        return;
+    }
+    mach_vm_address_t old = patcher.solveSymbol(index, "__ZN39AMDRadeonX6000_AMDAccelSharedUserClient15ForceLegacyModeEv", address, size);
+    FunctionHooks::oldX6000SharedUserClient = old != 0 && FunctionHooks::orgAccelSharedExternalMethod != 0;
+    SYSLOG(moduleName, "AMDRadeonX6000: old user-client numbering %s, selector redirects %s",
+           old ? "yes" : "no", FunctionHooks::oldX6000SharedUserClient ? "active" : "off");
+    patcher.clearError();
+}
