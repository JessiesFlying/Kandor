+// From macOS 13 Ventura on, displaypolicyd sends three AGDC structures with up to 32 entries instead of 16:
+// the scanout resource config (selector 0x978) as 0x8004 bytes, and the resource configuration set for
+// test/commit (0x1800/0x1801) as 0x7b8c bytes. OCLP installs the Monterey 12.5 AMDSupport 4.0.8 on Macs
+// without AVX2; it accepts only 0x4004 / 0x3dcc and <= 16 entries and returns kIOReturnBadArgument, so
+// displaypolicyd never brings an eGPU display online. These patches raise the sizes and limits (8 bytes,
+// 5 places). The loops only walk the caller's buffer. The patterns exist only in that 4.0.8 build; on
+// Apple's native driver, or an already patched one, nothing matches and nothing is changed.
+// Disable with -krynoagdc.
+void Patches::enlargeAGDCStructures(KernelPatcher &patcher, KernelPatcher::KextInfo *kext) {
+    if (!NVRAMArgs::isAMD() || getKernelVersion() < KernelVersion::Ventura || checkKernelArgument("-krynoagdc")) {
+        return;
+    }
+    
+    // getScanoutResourceConfig: size 0x4004 -> 0x8004
+    const uint8_t find1[] = {0xb8, 0x04, 0x40, 0x00, 0x00, 0x48, 0x3b, 0x45, 0xe0};
+    const uint8_t repl1[] = {0xb8, 0x04, 0x80, 0x00, 0x00, 0x48, 0x3b, 0x45, 0xe0};
+    // getScanoutResourceConfig: entries <= 16 -> <= 32
+    const uint8_t find2[] = {0x83, 0x7d, 0xd4, 0x10, 0x0f, 0x86, 0x0c};
+    const uint8_t repl2[] = {0x83, 0x7d, 0xd4, 0x20, 0x0f, 0x86, 0x0c};
+    // testConfiguration + commitConfiguration: size 0x3dcc -> 0x7b8c (2 matches)
+    const uint8_t find3[] = {0xb8, 0xcc, 0x3d, 0x00, 0x00, 0x48, 0x3b, 0x45, 0xe0, 0x0f, 0x84};
+    const uint8_t repl3[] = {0xb8, 0x8c, 0x7b, 0x00, 0x00, 0x48, 0x3b, 0x45, 0xe0, 0x0f, 0x84};
+    // testConfiguration: entries <= 16 -> <= 32
+    const uint8_t find4[] = {0x83, 0x7d, 0xd8, 0x10, 0x0f, 0x86};
+    const uint8_t repl4[] = {0x83, 0x7d, 0xd8, 0x20, 0x0f, 0x86};
+    // commitConfiguration: entries <= 16 -> <= 32
+    const uint8_t find5[] = {0x0f, 0xb6, 0x45, 0xdb, 0x83, 0xf8, 0x10};
+    const uint8_t repl5[] = {0x0f, 0xb6, 0x45, 0xdb, 0x83, 0xf8, 0x20};
+    
+    KernelPatcher::LookupPatch patches[] = {
+        {kext, find1, repl1, sizeof(find1), 1},
+        {kext, find2, repl2, sizeof(find2), 1},
+        {kext, find3, repl3, sizeof(find3), 2},
+        {kext, find4, repl4, sizeof(find4), 1},
+        {kext, find5, repl5, sizeof(find5), 1},
+    };
+    for (size_t i = 0; i < arrsize(patches); i++) {
+        patchApplicator.applyLookupPatch(patcher, &patches[i]);
+    }
+}
