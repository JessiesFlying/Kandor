+// The same AGDC size change for Navi: on Tahoe, OCLP installs the Monterey AMDRadeonX6000Framebuffer 4.8.101,
+// which also accepts only the 16-entry structures (0x4004 / 0x3dcc). Four places: the scanout resource config
+// size and entry limit, and the size checks of test and commit configuration (the 16-entry limit there is not
+// checked by this driver). Tested as a Lilu patch on Tahoe 26.7.3 / OCLP 3.0.0-rc.5 with an RX 6900 XT (Navi 21).
+// Tahoe (kernel 25) and later only: OCLP installs this Monterey framebuffer for Navi only there, and Apple's own
+// framebuffers on Ventura-Sequoia were not checked. The patterns are absent from Apple's Tahoe framebuffer.
+// Shares the -krynoagdc switch with the AMDSupport fix.
+// ne1rom, with assistance from Claude (Anthropic), GPL-3.0-only.
+void Patches::enlargeAGDCStructuresNavi(KernelPatcher &patcher, KernelPatcher::KextInfo *kext) {
+    if (!NVRAMArgs::isAMD() || getKernelVersion() < KernelVersion::Tahoe || checkKernelArgument("-krynoagdc")) {
+        return;
+    }
+
+    // getScanoutResourceConfig: cmp rdx,0x4004 -> 0x8004 (followed by jne)
+    const uint8_t find1[] = {0x48, 0x81, 0xfa, 0x04, 0x40, 0x00, 0x00, 0x75, 0x62};
+    const uint8_t repl1[] = {0x48, 0x81, 0xfa, 0x04, 0x80, 0x00, 0x00, 0x75, 0x62};
+    // getScanoutResourceConfig: cmp ebx,0x10 -> 0x20 (entries <= 16 -> <= 32, followed by jbe)
+    const uint8_t find2[] = {0x83, 0xfb, 0x10, 0x0f, 0x86, 0xbc, 0x00, 0x00, 0x00};
+    const uint8_t repl2[] = {0x83, 0xfb, 0x20, 0x0f, 0x86, 0xbc, 0x00, 0x00, 0x00};
+    // testConfiguration: cmp rdx,0x3dcc -> 0x7b8c (followed by a short jne)
+    const uint8_t find3[] = {0x48, 0x81, 0xfa, 0xcc, 0x3d, 0x00, 0x00, 0x75, 0x65};
+    const uint8_t repl3[] = {0x48, 0x81, 0xfa, 0x8c, 0x7b, 0x00, 0x00, 0x75, 0x65};
+    // commitConfiguration: cmp rdx,0x3dcc -> 0x7b8c (followed by a near jne)
+    const uint8_t find4[] = {0x48, 0x81, 0xfa, 0xcc, 0x3d, 0x00, 0x00, 0x0f, 0x85, 0xa5, 0x00, 0x00, 0x00};
+    const uint8_t repl4[] = {0x48, 0x81, 0xfa, 0x8c, 0x7b, 0x00, 0x00, 0x0f, 0x85, 0xa5, 0x00, 0x00, 0x00};
+
+    KernelPatcher::LookupPatch patches[] = {
+        {kext, find1, repl1, sizeof(find1), 1},
+        {kext, find2, repl2, sizeof(find2), 1},
+        {kext, find3, repl3, sizeof(find3), 1},
+        {kext, find4, repl4, sizeof(find4), 1},
+    };
+    for (size_t i = 0; i < arrsize(patches); i++) {
+        patchApplicator.applyLookupPatch(patcher, &patches[i]);
+    }
+}
+
