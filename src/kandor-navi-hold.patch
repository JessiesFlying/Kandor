+// Navi on Tahoe before OCLP's Navi root patch: on a Mac without AVX2, Apple's own Tahoe Navi driver attaches to the
+// eGPU, but its Metal driver needs AVX2, and WindowServer aborts in CoreDisplay_CreateDisplayForCGXDisplayDevice on
+// every start - no picture on any monitor, so OCLP's root patch can't be run from its window. While Apple's own
+// AMDRadeonX6000Framebuffer is loaded (no symbol and none of the patterns of OCLP's Monterey build), the probe of every Navi
+// controller returns no match: the card stays on the PCI bus (OCLP detects it and offers "AMD Navi"), the Mac
+// starts normally on its built-in GPUs. Once OCLP's Monterey framebuffer is installed, nothing is changed.
+// Tahoe (kernel 25) and later, krygpu=AMD, CPUs without AVX2 only. Off with -krynonavihold.
+// ne1rom, with assistance from Claude (Anthropic), GPL-3.0-only.
+void Patches::holdNativeNavi(KernelPatcher &patcher, size_t index, mach_vm_address_t address, size_t size) {
+    if (!NVRAMArgs::isAMD() || getKernelVersion() < KernelVersion::Tahoe || checkKernelArgument("-krynonavihold")) {
+        return;
+    }
+    uint32_t a = 0, b = 0;
+    if (CPUInfo::getCpuid(7, 0, &a, &b) && (b & (1U << 5))) {
+        SYSLOG(moduleName, "AMDRadeonX6000Framebuffer: CPU has AVX2, Apple's Navi driver left alone");
+        return;
+    }
+    // OCLP's Monterey framebuffer must never be held: two independent checks, either one is enough to leave it alone.
+    // 1) a symbol only the Monterey build has (resolved like the other symbol checks, also inside a kernel collection)
+    mach_vm_address_t oclpSymbol = patcher.solveSymbol(index, "__ZN27AMDRadeonX6000_AmdDalHelper18setPowerAdjustmentEj", address, size);
+    patcher.clearError();
+    if (oclpSymbol) {
+        SYSLOG(moduleName, "AMDRadeonX6000Framebuffer: OCLP's Navi build (symbol), no hold needed");
+        return;
+    }
+    // 2) the same OCLP-only patterns as in enlargeAGDCStructuresNavi (checked before that patch changes them)
+    const uint8_t oclp1[] = {0x48, 0x81, 0xfa, 0x04, 0x40, 0x00, 0x00, 0x75, 0x62};
+    const uint8_t oclp3[] = {0x48, 0x81, 0xfa, 0xcc, 0x3d, 0x00, 0x00, 0x75, 0x65};
+    size_t off = 0;
+    if (KernelPatcher::findPattern(oclp1, nullptr, sizeof(oclp1), reinterpret_cast<const void *>(address), size, &off) ||
+        KernelPatcher::findPattern(oclp3, nullptr, sizeof(oclp3), reinterpret_cast<const void *>(address), size, &off)) {
+        SYSLOG(moduleName, "AMDRadeonX6000Framebuffer: OCLP's Navi build, no hold needed");
+        return;
+    }
+    static const char *probes[] = {
+        "__ZN40AMDRadeonX6000_AmdRadeonControllerNavi105probeEP9IOServicePi",
+        "__ZN40AMDRadeonX6000_AmdRadeonControllerNavi125probeEP9IOServicePi",
+        "__ZN40AMDRadeonX6000_AmdRadeonControllerNavi145probeEP9IOServicePi",
+        "__ZN40AMDRadeonX6000_AmdRadeonControllerNavi215probeEP9IOServicePi",
+        "__ZN40AMDRadeonX6000_AmdRadeonControllerNavi235probeEP9IOServicePi",
+    };
+    for (size_t i = 0; i < arrsize(probes); i++) {
+        KernelPatcher::RouteRequest request(probes[i], FunctionHooks::naviHoldProbe);
+        patchApplicator.applyRoutingPatch(index, patcher, &request, address, size);
+    }
+    SYSLOG(moduleName, "AMDRadeonX6000Framebuffer: Apple's own Navi driver held off until OCLP's Navi patch is installed");
+}
